# Copy to .env in this folder. Restart npm run dev after changing.

# PostHog browser analytics (project key is public by design; also set these on Railway)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Where form emails are delivered
CONTACT_TO=maevepepple@gmail.com

# Web3Forms access key (sends the email to CONTACT_TO)
# Get one at https://web3forms.com — enter maevepepple@gmail.com
WEB3FORMS_ACCESS_KEY=

# Cloudflare Turnstile (accessible captcha)
# https://dash.cloudflare.com → Turnstile → Add widget
# Hostnames: localhost and your live domain
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
